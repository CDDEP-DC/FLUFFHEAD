# environments and caches
.venv/
__pycache__/
*.egg-info/
.DS_Store
cache/
logs/

# raw downloads (rebuild with `fluffhead fetch`)
data/raw/

# GREASYPOP working copies and generated networks (large; rebuild with `fluffhead networks`)
work/
data/regions/*/network/
data/regions/*/network-*/
data/regions-local/*/network/
data/regions-local/*/network-*/

# simulation outputs: keep summaries only
runs/*/*
!runs/*/summary/
runs-local/*/*
!runs-local/*/summary/

.env
.venv-greasypop/
.venv-geopops/
